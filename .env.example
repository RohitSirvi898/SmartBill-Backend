PORT=8000
MONGODB_URL=
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=60
CORS_ORIGIN=*

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

GEMINI_API_KEY=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Use REDIS_URL in managed Redis environments; REDIS_HOST/PORT are a local fallback.
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
INVOICE_WORKER_CONCURRENCY=2

# Single-line JSON string for Firebase admin service account
FIREBASE_SERVICE_ACCOUNT_JSON=

# Set true only where you run a persistent process (e.g. EC2 + PM2)
ENABLE_BILLING_CRON=false
